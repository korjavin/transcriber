# Incoming webhook from jitsi-capture
WEBHOOK_SECRET=change-me

# Shared audio volume. DATA_DIR is the path inside the container, HOST_DATA_DIR the
# path on the host (must equal jitsi-capture's HOST_DATA_DIR); compose mounts it at DATA_DIR.
DATA_DIR=/data
HOST_DATA_DIR=/srv/jitsi-capture/data

# Receiver port
PORT=8080

# ASR engine: parakeet (primary) | whisper (fallback)
ASR_ENGINE=parakeet
# Model cache: onnx-asr local model dir and HF_HOME for whisper
MODEL_DIR=/models

# faster-whisper (fallback backend)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# empty = autodetect
WHISPER_LANGUAGE=

# Outgoing webhook to tr2outline (primary publishing path)
TR2OUTLINE_URL=http://tr2outline:3000/api/webhooks/anarlog
ANARLOG_WEBHOOK_SECRET=change-me

# Direct Outline publishing (fallback path)
OUTLINE_BASE_URL=https://outline.your-domain.com
OUTLINE_API_KEY=change-me
OUTLINE_COLLECTION_ID=your_collection_uuid_here

# Logging
LOG_LEVEL=INFO

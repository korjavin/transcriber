# Приём вебхука от jitsi-capture
WEBHOOK_SECRET=change-me
DATA_DIR=/data

# Движок ASR: parakeet (основной) | whisper (резервный)
ASR_ENGINE=parakeet

# faster-whisper (резервный бэкенд)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# пусто = автоопределение языка
WHISPER_LANGUAGE=

# Отправка результата в tr2outline (основной путь публикации)
TR2OUTLINE_URL=http://tr2outline:3000/api/webhooks/anarlog
ANARLOG_WEBHOOK_SECRET=change-me

# Прямая публикация в Outline (резервный путь)
OUTLINE_BASE_URL=https://outline.your-domain.com
OUTLINE_API_KEY=change-me
OUTLINE_COLLECTION_ID=your_collection_uuid_here

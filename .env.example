# transcriber configuration. Copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored — never commit real hosts or secrets.

# --- Incoming webhook from jitsi-capture (required) -------------------------
# Shared secret: verifies the inbound POST /webhook and signs the callback.
WEBHOOK_SECRET=change-me

# --- Storage ----------------------------------------------------------------
# Container path for the shared audio volume; jobs live in DATA_DIR/jobs/<id>/
# and this service's own state in DATA_DIR/transcriber/.
DATA_DIR=/data
# Audio lives in the named volume `jitsi-capture-data`; this stack mounts that
# same volume at the same path as jitsi-capture, so HOST_DATA_DIR stays unset
# and the audio_path in the webhook needs no rebasing. Only set it if
# jitsi-capture reports its recordings under a different path than DATA_DIR.
#HOST_DATA_DIR=

# --- HTTP server ------------------------------------------------------------
# Port the receiver listens on inside the container. The Traefik label in
# docker-compose.yml points at 8080; change both together or not at all.
PORT=8080

# --- ASR --------------------------------------------------------------------
# ASR engine: parakeet (primary) | whisper (fallback)
ASR_ENGINE=parakeet
# Model cache: onnx-asr local model dir and HF_HOME for whisper.
MODEL_DIR=/models

# faster-whisper (fallback backend)
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# empty = autodetect
WHISPER_LANGUAGE=

# --- Outgoing webhook to tr2outline (required) ------------------------------
TR2OUTLINE_URL=http://tr2outline:3000/api/webhooks/anarlog
ANARLOG_WEBHOOK_SECRET=change-me

# --- Outline ----------------------------------------------------------------
# Base URL of the Outline instance. Used to absolutize a relative document url
# returned by tr2outline, and as the base for the direct-publishing fallback.
OUTLINE_BASE_URL=https://outline.your-domain.com

# --- Direct Outline publishing (fallback path) ------------------------------
OUTLINE_API_KEY=change-me
OUTLINE_COLLECTION_ID=your_collection_uuid_here

# --- Traefik ----------------------------------------------------------------
# Public hostname Traefik routes to this service (POST /webhook, GET /health).
DOMAIN=transcriber.your-domain.com
# Name of the existing external Docker network Traefik runs on.
TRAEFIK_NETWORK_NAME=traefik
# Traefik ACME certificate resolver that issues the TLS certificate.
TRAEFIK_CERTRESOLVER=myresolver

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
